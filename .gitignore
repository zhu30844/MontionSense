# ---------------------------------------------------------------------------
# MotionSense .gitignore
#
# NOTE: the cross-toolchain (tools/linux/toolchain), the vendored .so/.a under
# vendor/, and 3rdparty/ sources are INTENTIONALLY committed (a self-contained
# SDK build references them directly). Do not ignore them.
# ---------------------------------------------------------------------------

# --- C / CMake build output ---
/build/
/install/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# --- Go agent build output ---
# Compiled agent binary (build with `go build`; it does not belong in git).
/agent/agent
# Go test/coverage artifacts.
*.test
*.out
coverage.txt

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Logs / local runtime ---
*.log

# --- Luckfox SDK app build output ---
/build-sdk/
/install-sdk/

# --- Rockchip toolchain and flashing tools ---
# Provided by the Luckfox SDK checkout this tree lives in; see CMakeLists.txt.
/tools/

# --- Rockchip prebuilt media libraries ---
# Copyright Rockchip, no redistribution grant; populate with
# scripts/sync-vendor.sh from an SDK checkout. Only needed for standalone
# builds; the SDK app build uses MS_RK_MEDIA_DIR instead.
/vendor/
# The CMake glue in there is ours, not Rockchip's, and add_subdirectory needs
# it present before sync-vendor.sh has run.
!/vendor/*/CMakeLists.txt
