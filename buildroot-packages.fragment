# Buildroot packages MotionSense needs in the target rootfs.
#
# This file is the declaration; it is not consumed by buildroot directly.
# The Luckfox SDK passes RK_BUILDROOT_DEFCONFIG straight to buildroot as a
# make target, so buildroot needs one complete defconfig file and has no
# fragment or BR2_EXTERNAL mechanism wired up in this SDK. Rather than leave
# the dependency buried in an SDK file far from the code that needs it,
# it is declared here and applied with:
#
#     scripts/gen-buildroot-defconfig.sh
#
# which regenerates sysdrv/tools/board/buildroot/motionsense_defconfig from
# the vendor luckfox_pico_defconfig plus these lines. Run it after editing
# this file, then rebuild.
#
# Each entry names the shared library it is expected to provide, which is
# what cmake/SystemLibs.cmake looks for in the sysroot.

BR2_PACKAGE_LIBYAML=y   # libyaml-0.so.2   -> yaml::yaml
BR2_PACKAGE_SQLITE=y    # libsqlite3.so.0  -> sqlite3::sqlite3

# ntpd is disabled. The RTC on this board is battery-backed and keeps correct
# time on its own — verified across a reboot, where the kernel set the system
# clock from it to the right second. ntpd's first sync then stepped the clock
# eight hours forward and took three minutes to come back, during which the
# recorder created a day directory under tomorrow's date. Nothing needs a
# network time source often enough to be worth that.
# BR2_PACKAGE_NTP is not set

# Not listed, but relied on and already enabled in the vendor defconfig:
#   BR2_PACKAGE_FREETYPE   libfreetype.so.6  -> freetype::freetype
#   libiconv arrives as a dependency of other packages

# Only reaches builds started by hand from the buildroot directory. Buildroot
# drops its own -j when MAKEFLAGS already carries one, and sysdrv/Makefile
# always passes -j$(SYSDRV_JOBS), so a build through build.sh takes its
# parallelism from that jobserver and never reads this. Debugging a package
# with a bare "make" in the buildroot tree does read it, and the vendor base
# pins it at 4. 0 means one job per CPU plus one, decided at build time.
BR2_JLEVEL=0

# Top-level parallel build. Buildroot serialises itself with .NOTPARALLEL
# unless each package gets its own target and host directory, because without
# that isolation a package can see whatever happened to be installed before it
# and the result stops being reproducible. With it on, packages build
# concurrently and a many-core host is actually used; the jobserver from
# sysdrv/Makefile's -j is what limits it.
#
# Buildroot labels this experimental: a package that depends on something it
# never declared builds fine today and fails here. Switching it on or off
# changes the build layout, so buildroot has to be rebuilt from clean.
BR2_PER_PACKAGE_DIRECTORIES=y
